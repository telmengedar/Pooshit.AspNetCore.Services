<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Description>Middlewares, Filters and several other routines used in all Pooshit Asp Net Core Services</Description>
    <!-- single version source: the publish workflow overrides this via -p:Version from the git tag -->
    <Version>0.6.17-preview</Version>
    <PackageTags>Asp, Mvc, Middleware, Formatter</PackageTags>
    <Authors>Toni Gottschall</Authors>
    <LangVersion>default</LangVersion>
    <Company></Company>
    <RepositoryUrl>https://github.com/telmengedar/Pooshit.AspNetCore.Services</RepositoryUrl>
    <PackageProjectUrl>https://github.com/telmengedar/Pooshit.AspNetCore.Services</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    <PackageReference Include="Pooshit.Json" Version="0.3.40-preview" />
    <PackageReference Include="System.Linq.Async" Version="7.0.1" />
  </ItemGroup>

</Project>
